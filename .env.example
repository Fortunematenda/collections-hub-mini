# Email / SMTP — copy to .env and fill in real values
SMTP_HOST=mail.bretunetech.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=debtcollection@bretunetech.com
SMTP_PASS=
SMTP_FROM=debtcollection@bretunetech.com
SMTP_FROM_NAME=BretuneTech
# If BretuneTech MX rejects Gmail replies (550), set Reply-To to a Gmail you control
# and IMAP that Gmail instead (see IMAP_REPLY_* below).
# SMTP_REPLY_TO=your-collections@gmail.com
MAILER_PORT=8787
# Local dev: point UI at the API. On the server leave this empty (same origin).
VITE_API_URL=http://127.0.0.1:8787
# Browser origins allowed to call the API. Same-origin (this host) is always allowed.
# For a public IP deploy include the exact origin, e.g. http://161.97.120.107:8787
ALLOWED_ORIGIN=http://127.0.0.1:5173

ADMIN_EMAIL=admin@bretunetech.com
ADMIN_PASSWORD=
ADMIN_NAME=Collections Admin
# Generate a long random value. Do not use change-me on any server.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# PostgreSQL — local Docker: docker compose --env-file server/.env up -d
# Uses host port 5433 so it does not clash with other Postgres containers.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=collections_hub
DB_USER=collections_hub
DB_PASSWORD=
DATABASE_URL=postgresql://collections_hub:PASSWORD@127.0.0.1:5433/collections_hub
DATABASE_SSL=false

IMAP_HOST=mail.bretunetech.com
IMAP_PORT=993
# Uses SMTP_USER / SMTP_PASS unless IMAP_USER / IMAP_PASS are set
IMAP_POLL_SECONDS=20
# Built-in jobs: email promise-to-pay + overdue broken promises
COLLECTIONS_JOB_SECONDS=120
# Optional second inbox (Gmail) so customer replies skip BretuneTech’s 550 filter.
# IMAP_REPLY_HOST=imap.gmail.com
# IMAP_REPLY_PORT=993
# IMAP_REPLY_USER=your-collections@gmail.com
# IMAP_REPLY_PASS=gmail-app-password
POP3_HOST=mail.bretunetech.com
POP3_PORT=995

# Twilio WhatsApp — https://console.twilio.com
# Sandbox: join first, then use whatsapp:+14155238886 as from
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_DEFAULT_COUNTRY=27
TWILIO_CONTENT_SID=

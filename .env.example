# Email / SMTP — copy to .env and fill in real values
SMTP_HOST=mail.bretunetech.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=debtcollection@bretunetech.com
SMTP_PASS=
SMTP_FROM=debtcollection@bretunetech.com
SMTP_FROM_NAME=Debt Collections
MAILER_PORT=8787
# Local dev: point UI at the API. On the server leave this empty (same origin).
VITE_API_URL=http://127.0.0.1:8787

ADMIN_EMAIL=admin@bretunetech.com
ADMIN_PASSWORD=
ADMIN_NAME=Collections Admin
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

IMAP_HOST=mail.bretunetech.com
IMAP_PORT=993
POP3_HOST=mail.bretunetech.com
POP3_PORT=995

# Twilio WhatsApp — https://console.twilio.com
# Sandbox: join first, then use whatsapp:+14155238886 as from
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_DEFAULT_COUNTRY=27
